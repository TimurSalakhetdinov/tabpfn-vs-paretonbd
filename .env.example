# This project needs no secrets: TabPFN-3.5 runs locally and all data are public downloads.
# Copy to .env only if you want to change these defaults. Never commit .env.

# Repository root used for data/ and results/ (default: current working directory)
# TABPFN_VS_PARETONBD_ROOT=/path/to/tabpfn-vs-paretonbd

# macOS: avoid libomp conflicts if you run LightGBM and TabPFN in the same interpreter yourself
# OMP_NUM_THREADS=1

# Where tabpfn caches the downloaded weights (package default: ~/Library/Caches/tabpfn or ~/.cache/tabpfn)
# TABPFN_MODEL_CACHE_DIR=

# Only if the tabpfn package asks for a Prior Labs / Hugging Face token to download gated weights.
# Keep it here (untracked), never in code or results.
# TABPFN_TOKEN=
